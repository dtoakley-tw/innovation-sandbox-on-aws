# Generated Smithy packages. Produced by `npm run smithy:generate`; the model in
# source/api-model/ is the source of truth. Ignore generated contents directly so
# committed package manifests and server tsconfigs remain visible to both Git and
# rsync without a separate allowlist.
source/api-client/.gitignore
source/api-client/LICENSE
source/api-client/README.md
source/api-client/api-extractor.json
source/api-client/src/
source/api-client/dist-*/
source/api-client/tsconfig*.json
source/api-server/domains/
source/api-server/dist-*/

*.terraform
